# ===== Bot keuangan MineIDHost =====
# Website yang menyimpan data (jangan diubah kecuali domain berubah)
SITE_URL=https://mineidhost.com

# Sama persis dengan FIN_BOT_SECRET di Vercel (kode acak minimal 24 karakter)
FIN_BOT_SECRET=

# Nomor WhatsApp KHUSUS bot keuangan (format 628xxx). Isi untuk login pakai kode, kosongkan untuk QR.
PAIRING_NUMBER=

# ID grup WhatsApp keuangan. Ketik !idgrup di grup itu, lalu salin ke sini dan restart.
FIN_GROUP_JID=

# Admin yang boleh mencatat: nomor:nama, pisahkan koma. Contoh: 6281234567890:Abuz,6289876543210:Rizz
# Kosongkan = semua anggota grup keuangan boleh mencatat (nama diambil dari nama WhatsApp).
# Tidak terdeteksi? Ketik !saya di grup untuk melihat ID kamu, lalu tambahkan ID itu di sini.
FIN_ADMINS=

# Tanggal tutup buku & jam kirim laporan otomatis (WIB). Harus sama dengan FIN_CUTOFF_DAY di Vercel kalau diubah.
CUTOFF_DAY=28
REPORT_HOUR=20

LOG_LEVEL=warn
