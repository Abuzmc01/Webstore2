# ===== Bot notifikasi keuangan MineIDHost =====
# Bot ini HANYA mengirim notifikasi ke grup WhatsApp. Pencatatan dilakukan di mineidhost.com/admin-keuangan.

# Website yang menyimpan data (jangan diubah kecuali domain berubah)
SITE_URL=https://mineidhost.com

# Sama persis dengan FIN_BOT_SECRET di Vercel (kode acak minimal 24 karakter)
FIN_BOT_SECRET=

# Nomor WhatsApp KHUSUS bot keuangan (format 628xxx). Isi untuk login pakai kode, kosongkan untuk QR.
PAIRING_NUMBER=

# ID grup WhatsApp tujuan notifikasi. Ketik !idgrup di grup itu, salin ke sini, lalu restart.
FIN_GROUP_JID=

# Tanggal terakhir periode (sama dengan FIN_CUTOFF_DAY di Vercel kalau diubah) dan jam kirim rekap (WIB)
CUTOFF_DAY=28
REPORT_TIME=23:29

# Seberapa sering bot mengecek catatan baru di website (detik)
POLL_SECONDS=20

LOG_LEVEL=warn
