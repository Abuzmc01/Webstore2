# Salin file ini menjadi .env lalu isi semuanya.

# Kode rahasia, minimal 16 karakter acak. Harus SAMA dengan BOT_SECRET di Vercel.
BOT_SECRET=ganti-dengan-kode-acak-panjang

# Password untuk login halaman admin chat (mineidhost.com/admin-chat). Minimal 8 karakter.
ADMIN_PASSWORD=ganti-password-admin

# ID grup WhatsApp admin. Kosongkan dulu, lalu ketik !idgrup di grup untuk melihatnya.
GROUP_JID=

# Gmail pengirim transkrip. Pakai App Password (bukan password Gmail biasa):
# Google Account -> Keamanan -> Verifikasi 2 Langkah (aktifkan) -> Sandi aplikasi -> buat baru.
GMAIL_USER=mineidhost@gmail.com
GMAIL_APP_PASSWORD=

# Email yang menerima salinan transkrip setiap tiket ditutup.
SUPPORT_EMAIL=mineidhost@gmail.com

# Link rating Trustpilot yang dikirim ke pelanggan.
TRUSTPILOT_URL=https://www.trustpilot.com/evaluate/mineidhost.com

# Alamat website (dipakai untuk link admin chat di notifikasi WhatsApp).
SITE_URL=https://mineidhost.com

# Tiket otomatis ditutup kalau pelanggan tidak menjawab pertanyaan "masih ada yang bisa dibantu?" dalam X menit.
CONFIRM_TIMEOUT_MINUTES=30

# Port server. Di Pterodactyl tidak perlu diisi (otomatis pakai port allocation).
PORT=3000

# Opsional: isi nomor bot (format 628xxx) kalau ingin login pakai kode pairing, bukan QR.
PAIRING_NUMBER=
