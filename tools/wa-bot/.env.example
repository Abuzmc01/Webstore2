# Salin file ini menjadi .env lalu isi.

# Kode rahasia, minimal 16 karakter acak. Harus SAMA dengan WA_BOT_SECRET di Vercel.
BOT_SECRET=ganti-dengan-kode-acak-panjang

# ID grup WhatsApp admin. Kosongkan dulu, lalu ketik !idgrup di grup untuk melihatnya.
GROUP_JID=

# Port server tiket. Di Pterodactyl tidak perlu diisi (otomatis pakai port allocation).
PORT=3000

# Opsional: isi nomor bot (format 628xxx) kalau ingin login pakai kode pairing, bukan QR.
PAIRING_NUMBER=
